  "source_alignment": [
    {
      "source": "CMS Medicare Part D Prescribers by Provider and Drug",
      "url": "https://data.cms.gov/provider-summary-by-type-of-service/medicare-part-d-prescribers/medicare-part-d-prescribers-by-provider-and-drug",
      "actual_grain": "Annual x prescribing provider x drug",
      "used_for": "Structural reference for count/standardized fills and specialty concepts only; no numerical parameters fitted."
    },
    {
      "source": "CMS Monthly Part D Formulary",
      "url": "https://data.cms.gov/provider-summary-by-type-of-service/medicare-part-d-prescribers/monthly-prescription-drug-plan-formulary-and-pharmacy-network-information",
      "actual_grain": "Monthly x plan x drug(NDC)",
      "used_for": "Structural reference for formulary coverage, tier, PA, step therapy, quantity limit; no real plan IDs or numeric calibration; commercial/Medicaid/cash categories are invented outside the CMS Part D source."
    },
    {
      "source": "openFDA NDC",
      "url": "https://open.fda.gov/apis/drug/ndc/",
      "actual_grain": "NDC product registration metadata",
      "used_for": "Informed product/dosage metadata categories; no real NDCs used; not a sales/claim source."
    }
  ],
  "limitations": [
    "No public reference commercial sample uploaded; numeric volumes, shares, noise, seasonality, and event sizes are deliberately assumed.",
    "CMS Part D annual Medicare claims cannot provide weekly all-payer NRx/NBRx, market share, rep activity, or inventory.",
    "Fictional names, plan IDs and therapy class; no real clinical or commercial factual statements supported.",
    "observed rx feed includes intentional data-quality artifacts; market share and forecast actuals are provisional on those dates.",
    "evaluation truth is in a separate package excluded from agent-visible data."
  ]
}