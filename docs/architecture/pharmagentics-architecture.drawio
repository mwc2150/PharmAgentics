        <mxCell id="dw" value="&lt;b&gt;Data world · core-001&lt;/b&gt;&lt;br&gt;DuckDB local/pharmagentics.duckdb&lt;br&gt;raw: 14 agent-visible tables&lt;br&gt;metadata: imports, SHA-256&lt;br&gt;reporting: v_feed_health · v_reportable_rx · v_weekly_rx_kpis&lt;br&gt;seed 7 · release day1-v1 · 104 weeks · 8 territories" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="60" y="910" width="300" height="210" as="geometry"/></mxCell>
