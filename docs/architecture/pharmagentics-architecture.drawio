        <mxCell id="t" value="PharmAgentics — multi-agent system architecture" style="text;html=1;align=left;verticalAlign=top;fontSize=20;fontStyle=1;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="900" height="30" as="geometry"/></mxCell>
        <mxCell id="st" value="One shared platform · a seven-stage spine · two lanes. Stages 3 and 4 are doubled per lane; stage 4 is the only agentic stage. Sources: System Architecture (Oct 22), Briefing Architecture (Oct 21), specs/README.md. Forecast lane shown as reserved (owned by Alvin and Sienna)." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="1180" height="30" as="geometry"/></mxCell>
