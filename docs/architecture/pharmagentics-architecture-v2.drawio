        <mxCell id="b5" value="&lt;b&gt;5 · Narrative&lt;/b&gt;&lt;br&gt;brief-003 · LLM, constrained&lt;br&gt;writes prose with claim tokens such as {{c17}}; the renderer (code) fills every number from evidence · DRAFTED" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=11;spacing=4;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="bl"><mxGeometry x="1030" y="85" width="190" height="120" as="geometry"/></mxCell>
        <mxCell id="b6" value="&lt;b&gt;6 · Verifier&lt;/b&gt;&lt;br&gt;brief-004 · code + LLM judge&lt;br&gt;tokens resolve · no digit outside a token · reconciles to the snapshot · governed wording · no rep line · judge only once its agreement is measured (Eval 2)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=11;spacing=4;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="bl"><mxGeometry x="1030" y="285" width="190" height="140" as="geometry"/></mxCell>
        <mxCell id="pub" value="&lt;b&gt;Published Monday brief&lt;/b&gt;&lt;br&gt;KPI table · stories by impact · confidence · investigate next · data-health footnote · restatement disclosure" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=11;spacing=4;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;shape=document;boundedLbl=1;size=0.12;fillColor=#ffffff;" vertex="1" parent="bl"><mxGeometry x="1290" y="85" width="180" height="120" as="geometry"/></mxCell>
        <mxCell id="b7" value="&lt;b&gt;7 · Review, sign-off, feedback&lt;/b&gt;&lt;br&gt;brief-005 · human&lt;br&gt;P1 reviews and edits, then P2 signs off · every edit gets a failure tag and becomes an eval case" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=11;spacing=4;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="bl"><mxGeometry x="1290" y="285" width="180" height="140" as="geometry"/></mxCell>
        <mxCell id="eR" value="ROUTINE: no material change, straight to narrative" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#666666;fontColor=#666666;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;endArrow=block;endFill=1;exitX=0.5000;exitY=0.0000;exitDx=0;exitDy=0;entryX=0.3158;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="b3" target="b5"><mxGeometry x="0.0" y="0.0" relative="1" as="geometry"><Array as="points"><mxPoint x="360" y="412"/><mxPoint x="1340" y="412"/></Array></mxGeometry></mxCell>
