        <mxCell id="system-lgE" value="Solid arrow: run flow · dashed grey: loop-back or optional path · dashed green: read-only data access · dashed red: crosses the repository boundary" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=0;fontSize=10;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="1150" y="82" width="890" height="14" as="geometry"/></mxCell>
        <mxCell id="repo" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=11;spacing=4;fillColor=#ffffff;strokeColor=#999999;arcSize=2;dashed=1;fillColor=none;strokeColor=#666666;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="20" y="110" width="1730" height="1130" as="geometry"/></mxCell>
        <mxCell id="repoT" value="&lt;i&gt;PharmAgentics repository · ground truth never enters this boundary (shared Principle III)&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=0;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="36" y="114" width="1000" height="18" as="geometry"/></mxCell>
        <mxCell id="orch" value="&lt;b&gt;Run orchestrator · core-005 · code&lt;/b&gt; · one orchestrator for both lanes: run_id, transition log, run-level caps, timeouts, wall time, tokens and cost per stage. Every run ends in PUBLISHED or RUN_ERROR (alert, rerun with a new run_id). Each lane keeps its own trigger, state graph and Magentic loop; lanes never call each other in v1." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=11;spacing=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="1690" height="46" as="geometry"/></mxCell>
        <mxCell id="s1" value="&lt;b&gt;1 · Load and pin&lt;/b&gt;&lt;br&gt;core-003 · code&lt;br&gt;run_id pins data snapshot (import id, SHA-256), model, prompt and code versions · LOADED" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=11;spacing=4;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="205" width="180" height="100" as="geometry"/></mxCell>
        <mxCell id="s2" value="&lt;b&gt;2 · Validation gate&lt;/b&gt;&lt;br&gt;core-003 · code&lt;br&gt;reporting.v_feed_health: pass, warn or fail per week × territory. Failed cuts withheld, never read as zero. All cuts fail → data-health notice only (A7, proposed).&lt;br&gt;VALIDATED · VALIDATION_WARNING · VALIDATION_FAILED" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=11;spacing=4;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="180" height="170" as="geometry"/></mxCell>
