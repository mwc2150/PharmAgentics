        <mxCell id="e7r" value="RETURNED (A8)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#666666;fontColor=#666666;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;endArrow=block;endFill=1;exitX=0.1389;exitY=0.0000;exitDx=0;exitDy=0;entryX=0.8947;entryY=1.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="b7" target="b5"><mxGeometry x="0.0" y="0.0" relative="1" as="geometry"><Array as="points"><mxPoint x="1565" y="600"/><mxPoint x="1450" y="600"/></Array></mxGeometry></mxCell>
        <mxCell id="plat" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=11;spacing=4;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=2;fillColor=#f3f9f1;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="40" y="890" width="1690" height="340" as="geometry"/></mxCell>
        <mxCell id="platT" value="&lt;b&gt;Shared platform&lt;/b&gt; · specs/core-001 to core-006 · both teams" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=0;fontSize=11;fontColor=#1a1a2e;" vertex="1" parent="plat"><mxGeometry x="400" y="6" width="1200" height="18" as="geometry"/></mxCell>
        <mxCell id="dw" value="&lt;b&gt;Data world · core-001&lt;/b&gt;&lt;br&gt;DuckDB local/pharmagentics.duckdb&lt;br&gt;&lt;br&gt;raw: 14 agent-visible tables&lt;br&gt;metadata: imports, SHA-256&lt;br&gt;reporting: v_feed_health · v_reportable_rx · v_weekly_rx_kpis&lt;br&gt;&lt;br&gt;seed 7 · release day1-v1 · 104 weeks · 8 territories" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=11;spacing=4;fillColor=#d5e8d4;strokeColor=#82b366;shape=cylinder3;boundedLbl=1;size=14;rounded=0;" vertex="1" parent="plat"><mxGeometry x="20" y="45" width="340" height="280" as="geometry"/></mxCell>
        <mxCell id="sem" value="&lt;b&gt;Semantic layer · core-002&lt;/b&gt;&lt;br&gt;versioned YAML + Pydantic: metrics, dimensions, thresholds, hypothesis catalog, loop caps, aggregation floor, governed terms. Every stage reads its definitions here." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=11;spacing=4;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="plat"><mxGeometry x="400" y="40" width="260" height="135" as="geometry"/></mxCell>
        <mxCell id="tc" value="&lt;b&gt;Tool contract and registry · core-004&lt;/b&gt;&lt;br&gt;tool record · allowlist · typed errors (UnknownMetric, SuppressedCut, BelowFloor …) · typed handoffs (briefing.*, forecast.* seam)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=11;spacing=4;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="plat"><mxGeometry x="400" y="190" width="260" height="135" as="geometry"/></mxCell>
        <mxCell id="trc" value="&lt;b&gt;Tracing · core-006&lt;/b&gt;&lt;br&gt;OpenTelemetry → Arize Phoenix&lt;br&gt;every tool call, agent turn and LLM call emits a span&lt;br&gt;claim → evidence item → span" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=11;spacing=4;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="plat"><mxGeometry x="690" y="40" width="260" height="135" as="geometry"/></mxCell>
        <mxCell id="gov" value='&lt;b&gt;Governance&lt;/b&gt;&lt;br&gt;synthetic data only · no line identifies a rep · "competitive intelligence", never "surveillance" · agents propose, people decide' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=11;spacing=4;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="plat"><mxGeometry x="690" y="190" width="260" height="135" as="geometry"/></mxCell>
        <mxCell id="lg" value='&lt;b&gt;Loop guardrails · shared Principle VII, Briefing B-V&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. Depth two: manager → specialists → tools; tools hold no model.&lt;br&gt;2. Finite search: catalog in the semantic layer; no test reruns with the same parameters.&lt;br&gt;3. Caps as backstop: rounds, stalls, tool calls, wall time, tokens (values: Eval item 17).&lt;br&gt;4. Defined exit: a capped story closes as "unresolved, investigate next"; the brief is never blocked.&lt;br&gt;5. Numbers belong to code.' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=11;spacing=4;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="plat"><mxGeometry x="980" y="40" width="360" height="285" as="geometry"/></mxCell>
        <mxCell id="ev" value="&lt;b&gt;Eval harness · core-006&lt;/b&gt;&lt;br&gt;&lt;br&gt;the only reader of the answer key&lt;br&gt;scores each lane on its own pack (EV-x.y, FE-xx)&lt;br&gt;dev anchor cases (C-###, TC-##)&lt;br&gt;from the user stories&lt;br&gt;held-out seeded cases · repeated runs&lt;br&gt;scripted and low-code baselines" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=11;spacing=4;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="plat"><mxGeometry x="1370" y="40" width="300" height="285" as="geometry"/></mxCell>
