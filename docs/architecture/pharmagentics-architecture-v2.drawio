        <mxCell id="t" value="PharmAgentics · multi-agent system architecture" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=0;fontSize=20;fontColor=#1a1a2e;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="16" width="1100" height="30" as="geometry"/></mxCell>
        <mxCell id="st" value="One shared platform, a seven-stage spine, two lanes (System Architecture §3, §4; D1, D2). Stages 1 and 2 are shared; stages 3 to 7 run once per lane; stage 4 is the only agentic stage. Each box names its spec and its mode (Briefing B-II). The Forecast lane is reserved: Alvin and Sienna own it, and it is shown for context only." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=0;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="50" width="1100" height="48" as="geometry"/></mxCell>
        <mxCell id="system-lg" value="&lt;b&gt;Legend&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=0;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1150" y="4" width="300" height="16" as="geometry"/></mxCell>
        <mxCell id="system-lg0" value="Code (deterministic)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=11;spacing=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1150" y="22" width="285" height="26" as="geometry"/></mxCell>
        <mxCell id="system-lg1" value="LLM agent (calls Gemini)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=11;spacing=4;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1450" y="22" width="285" height="26" as="geometry"/></mxCell>
        <mxCell id="system-lg2" value="Human gate or reader" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=11;spacing=4;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1750" y="22" width="285" height="26" as="geometry"/></mxCell>
        <mxCell id="system-lg3" value="Shared platform (core-###)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=11;spacing=4;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1150" y="52" width="285" height="26" as="geometry"/></mxCell>
