{
  "realm": "pharmagentics",
  "displayName": "PharmAgentics",
  "loginTheme": "pharmagentics",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "editUsernameAllowed": false,
  "loginWithEmailAllowed": false,
  "duplicateEmailsAllowed": false,
  "bruteForceProtected": true,
  "ssoSessionIdleTimeout": 28800,
  "ssoSessionMaxLifespan": 28800,
  "requiredActions": [
    {"alias": "UPDATE_PASSWORD", "name": "Update Password", "providerId": "UPDATE_PASSWORD", "enabled": false, "defaultAction": false, "priority": 10, "config": {}},
    {"alias": "VERIFY_PROFILE", "name": "Verify Profile", "providerId": "VERIFY_PROFILE", "enabled": false, "defaultAction": false, "priority": 90, "config": {}}
  ],
  "roles": {
    "realm": [
      {"name": "briefing-analyst", "description": "P1 Commercial Analyst: analyst view, runs briefings and sends them for sign-off (core-007)"},
      {"name": "briefing-insights", "description": "P2 Insights Manager: reads the analyst view of briefings sent for sign-off, signs them off or returns them (brief-005)"},
      {"name": "briefing-director", "description": "P3 Brand Director: leadership view of signed-off briefings only (core-007)"},
      {"name": "briefing-marketer", "description": "P4 Marketer: leadership view of signed-off briefings only; content of its own comes later (brief-005)"},
      {"name": "forecast-analyst", "description": "CA Commercial Analyst: reserved; Alvin and Sienna confirm (core-007)"},
      {"name": "forecast-manager", "description": "BM Brand Manager: reserved; Alvin and Sienna confirm (core-007)"},
      {"name": "brand-bxa", "description": "Account grant for the Cardiovela (BXA) workspace"},
      {"name": "brand-bxc", "description": "Account grant for the Lipidara (BXC) workspace"},
      {"name": "tester", "description": "Test view: switches between the analyst (P1, CA), Insights Manager (P2), leadership (P3, BM) and Marketer (P4) roles; not a persona"}
    ]
  },
  "clients": [
    {
      "clientId": "pharmagentics-app",
      "name": "PharmAgentics web app",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${PHARMAGENTICS_OIDC_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "rootUrl": "${PHARMAGENTICS_APP_URL}",
      "baseUrl": "/",
      "redirectUris": ["${PHARMAGENTICS_APP_URL}/auth/callback"],
      "webOrigins": ["${PHARMAGENTICS_APP_URL}"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${PHARMAGENTICS_APP_URL}/*"
      },
      "defaultClientScopes": ["profile", "basic"],
      "optionalClientScopes": [],
      "protocolMappers": [
        {
          "name": "realm roles in ID token",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "uat-briefing-analyst",
      "enabled": true,
      "firstName": "Ace",
      "email": "uat-briefing-analyst@pharmagentics.test",
      "emailVerified": true,
      "credentials": [{"type": "password", "value": "${UAT_PASSWORD_BRIEFING_ANALYST}", "temporary": false}],
      "realmRoles": ["briefing-analyst", "brand-bxa", "brand-bxc"]
    },
    {
      "username": "uat-briefing-insights",
      "enabled": true,
      "firstName": "Marcus",
      "email": "uat-briefing-insights@pharmagentics.test",
      "emailVerified": true,
      "credentials": [{"type": "password", "value": "${UAT_PASSWORD_BRIEFING_INSIGHTS}", "temporary": false}],
      "realmRoles": ["briefing-insights", "brand-bxa", "brand-bxc"]
    },
    {
      "username": "uat-briefing-director",
      "enabled": true,
      "firstName": "Diana",
      "email": "uat-briefing-director@pharmagentics.test",
      "emailVerified": true,
      "credentials": [{"type": "password", "value": "${UAT_PASSWORD_BRIEFING_DIRECTOR}", "temporary": false}],
      "realmRoles": ["briefing-director", "brand-bxa", "brand-bxc"]
    },
    {
      "username": "uat-briefing-marketer",
      "enabled": true,
      "firstName": "Magdalena",
      "email": "uat-briefing-marketer@pharmagentics.test",
      "emailVerified": true,
      "credentials": [{"type": "password", "value": "${UAT_PASSWORD_BRIEFING_MARKETER}", "temporary": false}],
      "realmRoles": ["briefing-marketer", "brand-bxa", "brand-bxc"]
    },
    {
      "username": "uat-forecast-analyst",
      "enabled": true,
      "firstName": "Ace",
      "email": "uat-forecast-analyst@pharmagentics.test",
      "emailVerified": true,
      "credentials": [{"type": "password", "value": "${UAT_PASSWORD_FORECAST_ANALYST}", "temporary": false}],
      "realmRoles": ["forecast-analyst", "brand-bxa"]
    },
    {
      "username": "uat-forecast-manager",
      "enabled": true,
      "firstName": "Miranda",
      "email": "uat-forecast-manager@pharmagentics.test",
      "emailVerified": true,
      "credentials": [{"type": "password", "value": "${UAT_PASSWORD_FORECAST_MANAGER}", "temporary": false}],
      "realmRoles": ["forecast-manager", "brand-bxa"]
    },
    {
      "username": "uat-tester",
      "enabled": true,
      "firstName": "Tester",
      "email": "uat-tester@pharmagentics.test",
      "emailVerified": true,
      "credentials": [{"type": "password", "value": "${UAT_PASSWORD_TESTER}", "temporary": false}],
      "realmRoles": ["tester", "brand-bxa", "brand-bxc"]
    }
  ]
}
